PORT=5008
MONGO_URI=mongodb://localhost:27017/ecommerce_cart_api
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=2h
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# MONGO_URI above must point to a replica set for transactions to work.
# Easiest local option: run a single-node replica set with Docker, e.g.
#   docker run -d -p 27017:27017 --name mongo-rs mongo --replSet rs0
#   docker exec -it mongo-rs mongosh --eval "rs.initiate()"
